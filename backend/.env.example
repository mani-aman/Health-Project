# ─── Required ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/healthai?retryWrites=true&w=majority
JWT_SECRET=<minimum-32-character-random-string>
PORT=5000

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Protected Admin Bootstrap (server-side only, never in frontend) ──────────
PROTECTED_ADMIN_EMAIL=admin@healthai.com
PROTECTED_ADMIN_PASSWORD=<strong-password-min-12-chars>
PROTECTED_ADMIN_FIRST_NAME=Protected
PROTECTED_ADMIN_LAST_NAME=Admin

# ─── Email (optional - signup emails disabled if missing) ─────────────────────
EMAIL_USER=
EMAIL_PASS=

# ─── AI (optional - mock fallback used if missing) ───────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
